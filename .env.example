# Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Optional default Chat ID or Channel ID where notifications will be sent
# (You can also send /start directly in Telegram to subscribe any chat)
TELEGRAM_CHAT_ID=-1001234567890

# Polling frequency in seconds (default: 300 = 5 minutes)
CHECK_INTERVAL_SECONDS=300

# Target OS platforms to monitor (comma-separated list: iOS, macOS, iPadOS, watchOS, visionOS, tvOS, Xcode)
TARGET_OS=iOS, macOS

# Filter release channels (true/false)
INCLUDE_DEV_BETAS=true
INCLUDE_PUBLIC_BETAS=true
INCLUDE_STABLE=true

# Database storage path inside container (default: data/releases.db)
DATABASE_PATH=data/releases.db
